# CFO Cockpit environment-specific settings
# Do not commit real secret values. Resource IDs are not secrets, but keeping
# environment-specific IDs outside source code makes the same repo portable.

# Data layer
CFO_DATA_CATALOG=frbg3as_studio_a
CFO_DATA_SCHEMA=cfo_cockpit
CFO_RAW_VOLUME=raw_files
CFO_OUTPUT_DIR=/Volumes/frbg3as_studio_a/cfo_cockpit/raw_files/generated

# Databricks App SQL warehouse (set one of these)
DATABRICKS_WAREHOUSE_ID=<abn_sql_warehouse_id>
# DATABRICKS_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<abn_sql_warehouse_id>

# Genie resource
GENIE_SPACE_ID=<abn_genie_agent_or_space_id>
